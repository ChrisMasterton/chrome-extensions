{
  "manifest_version": 3,
  "name": "Element Picker QA Bridge",
  "description": "Build QA debug bundles with comments, tour context, and Codex guided review handoffs through a local inbox",
  "version": "1.9",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "downloads"],
  "host_permissions": ["http://127.0.0.1:43117/*"],
  "action": {
    "default_title": "Pick Element",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
